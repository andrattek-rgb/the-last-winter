[connection signal="pressed" from="Credits/Content/Navigation/Next" to="." method="_turn_page" binds=[1]]
[connection signal="pressed" from="Credits/Content/Back" to="." method="_back_home"]
[connection signal="pressed" from="Disclaimer/Content/Proceed" to="." method="_start_game"]
[connection signal="confirmed" from="ReplaceDialog" to="." method="_restart_selected_slot"]
