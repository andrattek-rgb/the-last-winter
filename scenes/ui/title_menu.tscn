[node name="Message" type="Label" parent="Disclaimer/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 23
text = "NOWHERE is a work of fiction inspired by real historical events.\n\nDespite its cartoon art style, this game is not intended to trivialize, ridicule, or diminish the suffering of the victims of the Holocaust.\n\nIts purpose is to tell a story of loss, survival, and hope, encouraging reflection on one of the darkest chapters in human history.\n\nDedicated to the memory of all victims of the Holocaust."
horizontal_alignment = 1
autowrap_mode = 3

[node name="Closing" type="Label" parent="Disclaimer/Content"]
layout_mode = 2
theme_override_fonts/font = ExtResource("4")
theme_override_font_sizes/font_size = 21
text = "May the past never be forgotten."
horizontal_alignment = 1

